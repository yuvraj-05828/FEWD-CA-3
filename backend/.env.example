# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cook_recipe_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRE=7d

# CORS Allowed Origin (Frontend URL or comma-separated URLs)
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5500
